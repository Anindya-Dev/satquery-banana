# SatQuery AI Backend Environment Configuration Template

DEBUG=True
HOST=0.0.0.0
PORT=8000

# Public source for real Sentinel-2 L2A imagery
STAC_API_URL=https://planetarycomputer.microsoft.com/api/stac/v1
STAC_COLLECTION=sentinel-2-l2a
STAC_SEARCH_LIMIT=20
RASTER_MAX_DIMENSION=768
PLANETARY_COMPUTER_SUBSCRIPTION_KEY=
CORS_ORIGINS=https://satquery-banana.vercel.app,http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=20
RESPONSE_CACHE_TTL_SECONDS=900
NOMINATIM_USER_AGENT=SatQueryAI/1.0 (contact: your-email@example.com)

# VLM Provider Settings
LITELLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
ALLOW_MOCK_FALLBACK=True

# Scientific & Quality Refusal Thresholds
MAX_ALLOWED_CLOUD_PERCENT=15.0
MIN_VALID_PIXEL_RATIO=0.75
GOOD_COREGISTRATION_SHIFT_PX=3.0
MAX_DEGRADED_COREGISTRATION_SHIFT_PX=6.0
MIN_CONFIDENCE_THRESHOLD=0.70
