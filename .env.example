# SatQuery AI Environment Configuration Template

# Server Configuration
DEBUG=True
HOST=0.0.0.0
PORT=8000

# VLM / AI Provider Settings
LITELLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
ALLOW_MOCK_FALLBACK=True

# Scientific & Quality Refusal Thresholds
MAX_ALLOWED_CLOUD_PERCENT=15.0
MIN_VALID_PIXEL_RATIO=0.75
GOOD_COREGISTRATION_SHIFT_PX=3.0
MAX_DEGRADED_COREGISTRATION_SHIFT_PX=6.0
MIN_CONFIDENCE_THRESHOLD=0.70

# Semantic Search State
SEMANTIC_RERANK_MODE=MOCKED_SEMANTIC_RERANK

# Frontend API URL (for Vite)
# Local development:
VITE_API_BASE_URL=http://localhost:8000
# Production (Render deployment):
# VITE_API_BASE_URL=https://satquery-backend-x0fy.onrender.com
